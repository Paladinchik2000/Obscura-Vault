<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- STRICT OFFLINE REQUIREMENT: NO INTERNET PERMISSION DECLARED -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="28" />

    <!-- Every activity is portrait-only: the PIN keypad does not fit a landscape phone screen, and the
         autofill prompt can open on top of another app that is in landscape. -->
    <application
        android:name=".ObscuraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obscura">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.Obscura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unlock step of an autofill request: the app's own PIN or fingerprint, never the
             device PIN. Started only through our own PendingIntent, so it stays unexported. -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Obscura"
            android:windowSoftInputMode="adjustResize" />

        <!-- BIND_AUTOFILL_SERVICE is the attribute of the service, not a uses-permission:
             it lets only the system bind to it. -->
        <service
            android:name=".autofill.ObscuraAutofillService"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Transparent Jetpack Compose Activity for Autofill Biometric Authentication -->
        <activity
            android:name=".autofill.AutofillBiometricAuthActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Obscura.TransparentDialog"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
